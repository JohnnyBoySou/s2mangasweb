{
    "compilerOptions": {
      "jsx": "react",
      "baseUrl": "./",
      "paths": {
        "@components/*": ["src/components/*"],
        "@page/*": ["src/app/*"],
        "@data/*": ["old/data/*"],
        "@hooks/*": ["src/hooks/*"],
        "@themes/*": ["old/themes/*"],
        "@imgs/*": ["src/assets/*"],
        "@requests/*": ["old/requests/*"],
        "@api/*": ["old/requests/api/*"],

        "@/api/*": ["src/api/*"],
        "@/utils/*": ["src/utils/*"],
        "@/hooks/*": ["src/hooks/*"],
        "@/components/*": ["src/components/*"],
        "@/assets/*": ["src/assets/*"],
        "@/pages/*": ["src/pages/*"],
        "@/ui/*": ["src/ui/*"],
        "@/imgs/*": ["public/imgs/*"],
        "@/context/*": ["src/context/*"],
        "@/translations/*": ["src/translations/*"],
      }
    }
  }